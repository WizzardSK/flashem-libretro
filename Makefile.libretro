# ─────────────────────────────────────────────────────────────
#  libretro core build
#
#  The core is the emulator without its SDL frontend: no window, no SDL audio
#  device, no debugger. All it needs is a C compiler and libm; FLASHEM_NO_SDL
#  keeps audio.c from reaching for SDL headers a core build has no use for.
#
#  make -f Makefile.libretro platform=unix
# ─────────────────────────────────────────────────────────────

TARGET_NAME := flashem
ifeq ($(platform),)
	platform = unix
	ifeq ($(shell uname -s),)
		platform = win
	else ifneq ($(findstring MINGW,$(shell uname -s)),)
		platform = win
	else ifneq ($(findstring Darwin,$(shell uname -s)),)
		platform = osx
	endif
endif

CORE_DIR := .
SOURCES_C := \
	$(CORE_DIR)/src/flashem_libretro.c \
	$(CORE_DIR)/src/vflash.c \
	$(CORE_DIR)/src/hw.c \
	$(CORE_DIR)/src/zevio_dsp.c \
	$(CORE_DIR)/src/zsp400.c \
	$(CORE_DIR)/src/midi.c \
	$(CORE_DIR)/src/cdda_dma.c \
	$(CORE_DIR)/src/arm9.c \
	$(CORE_DIR)/src/cp15.c \
	$(CORE_DIR)/src/cdrom.c \
	$(CORE_DIR)/src/cdsp.c \
	$(CORE_DIR)/src/ge.c \
	$(CORE_DIR)/src/audio.c \
	$(CORE_DIR)/src/disasm.c

LIBS := -lm
fpic :=
SHARED :=

# The core is dlopened next to a frontend that has symbols of its own; without
# this the dynamic linker can bind our calls to the frontend's copies.
LINK_VERSION_SCRIPT := -Wl,--version-script=$(CORE_DIR)/link.T -Wl,-Bsymbolic

# ── Unix ─────────────────────────────────────────────────────
ifneq (,$(findstring unix,$(platform)))
	TARGET := $(TARGET_NAME)_libretro.so
	fpic := -fPIC
	SHARED := -shared $(LINK_VERSION_SCRIPT)
	ifneq (,$(findstring Haiku,$(shell uname -s)))
		LIBS :=
	endif

# ── macOS ────────────────────────────────────────────────────
else ifeq ($(platform), osx)
	TARGET := $(TARGET_NAME)_libretro.dylib
	fpic := -fPIC
	SHARED := -dynamiclib
	ifeq ($(CROSS_COMPILE),1)
		TARGET_RULE = -target $(LIBRETRO_APPLE_PLATFORM) -isysroot $(LIBRETRO_APPLE_ISYSROOT)
		CFLAGS += $(TARGET_RULE)
		LDFLAGS += $(TARGET_RULE)
	endif

# ── iOS / tvOS ───────────────────────────────────────────────
else ifneq (,$(findstring ios,$(platform)))
	TARGET := $(TARGET_NAME)_libretro_ios.dylib
	fpic := -fPIC
	SHARED := -dynamiclib
	MINVERSION := -miphoneos-version-min=12.0
	IOSSDK := $(shell xcodebuild -version -sdk iphoneos Path 2>/dev/null)
	CC := cc -arch arm64 -isysroot $(IOSSDK) $(MINVERSION)
	CFLAGS += -DIOS

# ── Android ──────────────────────────────────────────────────
else ifneq (,$(findstring android,$(platform)))
	TARGET := $(TARGET_NAME)_libretro_android.so
	fpic := -fPIC
	SHARED := -shared $(LINK_VERSION_SCRIPT)
	CC = $(ANDROID_CC)

# ── Emscripten ───────────────────────────────────────────────
else ifeq ($(platform), emscripten)
	TARGET := $(TARGET_NAME)_libretro_emscripten.bc
	STATIC_LINKING = 1

# ── Windows (MinGW) ──────────────────────────────────────────
else
	TARGET := $(TARGET_NAME)_libretro.dll
	# cross-compiling from Linux/WSL: MinGW-w64 unless CC was given
	ifneq ($(OS),Windows_NT)
		ifeq ($(origin CC),default)
			CC := x86_64-w64-mingw32-gcc
		endif
	endif
	SHARED := -shared -static-libgcc -Wl,--no-undefined $(LINK_VERSION_SCRIPT)
endif

ifeq ($(DEBUG), 1)
	CFLAGS += -O0 -g
else
	CFLAGS += -O2 -DNDEBUG
endif

# Own suffix, so objects left by the standalone Makefile (built without -fPIC
# and with SDL) are never linked into the core.
OBJECTS := $(SOURCES_C:.c=.lr.o)
CFLAGS  += -Wall -Wextra -std=gnu11 $(fpic) -I$(CORE_DIR)/src -DFLASHEM_NO_SDL

all: $(TARGET)

# Header dependencies, written by the compiler and read back (see Makefile).
CFLAGS  += -MMD -MP
DEPS    := $(OBJECTS:.o=.d)
-include $(DEPS)

ifeq ($(STATIC_LINKING), 1)
$(TARGET): $(OBJECTS)
	$(AR) rcs $@ $(OBJECTS)
else
$(TARGET): $(OBJECTS)
	$(CC) $(fpic) $(SHARED) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS)
endif

%.lr.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJECTS) $(DEPS) $(TARGET)

.PHONY: all clean
