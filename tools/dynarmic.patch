+    // flashem: the control field (mode, I, F) belongs to the host, whose
+    // interpreter keeps the banked registers of each mode. The host gets the
+    // instruction as an SVC call outside the 24-bit SWI numbers (bit 31, bit
+    // 30 for an immediate, the field mask in bits 16-19, the rotate and imm8
+    // or the register below) and writes the CPSR itself - or, for a change
+    // of mode, halts and runs it on its interpreter (the PC is the MSR's
+    // during the call).
+    if (mcl::bit::get_bit<0>(mask)) {
+        if (!ArmConditionPassed(cond)) {
+            return true;
+        }
+        ir.UpdateUpperLocationDescriptor();
+        ir.BranchWritePC(ir.Imm32(ir.current_location.PC()));
+        ir.CallSupervisor(ir.Imm32(0xC0000000 | (mask << 16) | (static_cast<u32>(rotate) << 8) | imm8.ZeroExtend()));
+        ir.BranchWritePC(ir.Imm32(ir.current_location.PC() + 4));
+        ir.SetTerm(IR::Term::CheckHalt{IR::Term::LinkBlock{ir.current_location.AdvancePC(4)}});
+        return false;
+    }
+
